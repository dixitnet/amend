[Unit]
Description=amend.ink backend
After=network.target

[Service]
Type=simple
User=amend
WorkingDirectory=/opt/amend/app
ExecStart=/usr/bin/node server/server.js
EnvironmentFile=/opt/amend/app/.env
Restart=on-failure
RestartSec=5
MemoryMax=700M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
