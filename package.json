{
  "name": "collabtext",
  "version": "0.1.0",
  "private": true,
  "description": "Édition collaborative de texte avec suivi des modifications et assistance IA — auto-hébergé, une seule dépendance côté serveur (yjs).",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "build:client": "cd client && npm install && npm run build",
    "test:server": "node tools/lancer-tests.mjs server/test",
    "test:client": "cd client && node ../tools/lancer-tests.mjs test",
    "test": "npm run test:server && npm run test:client",
    "loadtest": "node tools/loadtest.js",
    "lint": "eslint .",
    "format": "prettier --write",
    "format:check": "prettier --check \"server/**/*.js\" \"shared/**/*.js\" \"client/src/**/*.js\" \"tools/**/*.{js,mjs}\""
  },
  "dependencies": {
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.18"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "ws": "^8.18.0"
  }
}
