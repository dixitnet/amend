# Copie ce fichier en ".env" (même dossier) et renseigne ta clé pour
# activer l'assistance IA. Sans clé, l'appli fonctionne normalement pour
# l'édition collaborative et le suivi des modifications humain — seul le
# bouton "Suggérer une reformulation" renverra une erreur claire.

ANTHROPIC_API_KEY=

# Optionnel — clé de Mistral, seulement si le back-office (#/admin/ia) propose
# « Mistral Large 4 » à une des deux fonctions (14/10/2026). Les requêtes partent
# au point d'accès européen de Mistral (api.eu.mistral.ai). Sans cette clé, ce
# modèle répond « clé non configurée » ; Haiku et Sonnet n'en dépendent pas.
MISTRAL_API_KEY=

# Optionnel — clé de Scaleway (Generative APIs, Paris), seulement si le back-office
# (#/admin/ia) propose « gpt-oss 120B », « Qwen 3.5 397B » ou « Qwen 3 235B Instruct »
# à une des deux fonctions (29/10/2026). Utilise la clé secrète d'un projet Scaleway
# **dédié** à amend.ink. Les requêtes partent à api.scaleway.ai ; les coûts s'affichent
# en euros. Sans cette clé, ces modèles répondent « clé non configurée » ; Claude et
# Mistral n'en dépendent pas. Ne jamais coller la clé dans une conversation.
SCALEWAY_API_KEY=

# L'IA a deux fonctions, réglées chacune dans le back-office (#/admin/ia,
# 13/10/2026), plus dans ce fichier : « Corrections IA » (la barre latérale)
# et « Margo » (le dialogue flottant). Pour chacune : le modèle (Haiku 5.5,
# Sonnet 5.5, Mistral Large 4 ou les trois modèles de Scaleway), le nombre de signes envoyés au plus par demande, le nombre de
# demandes au plus par heure, le nombre de signes envoyés au plus par mois et
# par personne, et le niveau d'accès minimal (administrateurs, éditeurs,
# correcteurs). Tout se compte en signes, espaces compris. Les variables
# AI_MODEL, AI_SUGGESTIONS_PAR_HEURE, AI_SUGGESTIONS_PAR_JOUR, DIALOGUE_MODEL,
# DIALOGUE_MESSAGES_PAR_HEURE et CLAUDE_DIALOGUE ne sont plus lues : on peut
# les retirer du .env.

# Optionnel — tarif du modèle, en euros par million de jetons. Sert
# uniquement à traduire en somme lisible, dans le back-office, les jetons
# déjà journalisés : rien dans l'application ne s'en sert pour décider quoi
# que ce soit, et un tarif périmé fausse un affichage, jamais un
# comportement. Défauts = tarif de claude-haiku-5-5 (0,10 $ / 0,50 $) converti au
# taux de référence BCE du 15/09/2026 (1 € = 1,1539 $). Ils ne valent que pour
# l'ancienne vue d'ensemble du back-office ; la page des réglages de l'IA estime
# le coût, en dollars, modèle par modèle. Le vrai plafond de dépense se pose
# côté Anthropic.
# AI_PRICE_INPUT_EUR=0.087
# AI_PRICE_OUTPUT_EUR=0.434

# Optionnel — port d'écoute du serveur (par défaut 8787).
# PORT=8787
# Interface d'écoute (S19). Par défaut la boucle locale : Caddy est sur la même
# machine et le port ne doit pas être joignable autrement. 0.0.0.0 pour un
# conteneur ou un autre proxy.
# HOST=127.0.0.1

# Optionnel — dossier où sont stockés les documents (par défaut ./data).
# DATA_DIR=./data

# --- Images collées dans les documents (voir claude/etude-tableaux-images.md
# dans le projet Amend) ---
#
# Les octets vivent dans DATA_DIR/uploads, jamais dans le document lui-même.
# Deux garde-fous, en mégaoctets : ce qu'une image peut peser au maximum, et
# ce que l'ensemble des images d'un document peut peser. Le bon réglage
# dépend du disque de l'instance et de l'usage réel — d'où le .env plutôt
# qu'une constante à redéployer. Le client réduit déjà tout à 1600 px de
# large, ce qui ramène une capture d'écran à ~200 Ko.
# MAX_IMAGE_MB=5
# MAX_DOC_IMAGES_MB=100

# Plafonds par compte (audit S14, 10/10/2026) : nombre de documents dont une
# adresse est propriétaire, et poids de toutes leurs images ensemble. Les
# administrateurs (ADMIN_EMAILS) n'en ont pas. Une valeur absurde retombe sur
# le défaut.
# DOCUMENTS_MAX_PAR_COMPTE=200
# IMAGES_MAX_PAR_COMPTE_MO=500

# --- Gestion des utilisateurs (voir claude/conception-gestion-utilisateurs.md
# dans le projet Amend) ---

# Emails autorisés à se connecter/créer des documents sans invitation
# préalable (séparés par des virgules) — sert aussi pour les routes
# d'administration (feuille de style partagée, diagnostic). Tout le monde
# d'autre n'entre que par un lien d'invitation à un document précis.
# ADMIN_EMAILS=vous@exemple.fr

# Optionnel — secret de signature des sessions (HMAC). Sans valeur, un
# secret aléatoire est généré au démarrage : ça fonctionne, mais un
# redémarrage du serveur déconnecte tout le monde. À définir en production.
# SESSION_SECRET=

# Requis pour l'envoi d'email de reconnexion (lien magique) via l'API
# Mailgun. Sans ces deux valeurs, la demande de reconnexion échoue
# silencieusement côté serveur (erreur journalisée, réponse HTTP inchangée
# pour ne pas révéler d'information) — l'entrée initiale par lien
# d'invitation, elle, ne nécessite aucun email sortant.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# Optionnel — expéditeur affiché (par défaut no-reply@<MAILGUN_DOMAIN>).
# MAILGUN_FROM=
# Optionnel — le compte Mailgun de Sylvain est en zone EU (api.eu.mailgun.net,
# valeur par défaut) plutôt qu'US (api.mailgun.net) ; à changer seulement si
# un compte US est utilisé un jour.
# MAILGUN_API_HOST=api.eu.mailgun.net

# Optionnel — base des liens envoyés par email ou générés pour l'invitation
# (par défaut http://localhost:<PORT>). À définir en production
# (https://www.amend.ink) pour que les liens ne pointent pas vers le Mac.
# APP_BASE_URL=

# Qui peut publier un document sur le web (voir server/publication.js).
#   admins        — phase de test : les seules adresses d'ADMIN_EMAILS
#   proprietaires — le propriétaire de chaque document
#   editeurs      — tout éditeur du document
# Une valeur inconnue retombe sur « admins ». Un correcteur ne publie jamais.
PUBLICATION_WEB=admins

# Qui peut inviter Claude sur un document, depuis « Partager → Gérer les
# accès » (voir server/agents.js) : même échelle que PUBLICATION_WEB.
#   admins        — phase de test : les seules adresses d'ADMIN_EMAILS
#   proprietaires — le propriétaire de chaque document
#   editeurs      — tout éditeur du document
# Une valeur inconnue retombe sur « admins ». Un correcteur n'invite jamais.
# Tout éditeur peut, lui, retirer l'accès de Claude quelle que soit la valeur.
CLAUDE_AGENT=admins

# Politique de contenu (CSP) de l'application, en deux temps (voir
# server/enTetes.js) :
#   enforce     — défaut (depuis le 10/10/2026, y compris pour une valeur
#                 inconnue) : le navigateur bloque ;
#   report-only — il signale les violations dans sa console, sans rien
#                 bloquer (pour essayer une politique modifiée) ;
#   off         — aucune CSP (retour en arrière).
# Les autres en-têtes (nosniff, cadres interdits…) sont toujours posés.
# CSP_MODE=enforce

# Un correcteur ne modifie le texte qu'en suivi de modifications et ne signe
# que ses propres propositions ; ses commentaires portent son identifiant
# (voir server/correcteur.js et server/replique.js).
#   observer — défaut : le serveur vérifie chaque opération d'un correcteur,
#              journalise les violations (console + data/
#              events-correcteur.jsonl) mais laisse tout passer ;
#   refuser  — la violation est refusée, le client recharge le document ;
#   off      — aucune vérification.
# À passer en « refuser » après quelques semaines sans violation signalée.
# CORRECTEUR_ETANCHE=observer

# --- Export PDF (Typst) ---
# Optionnel. Le PDF se fabrique avec le binaire `typst`, appelé en sous-processus
# (server/typst.js) ; sans lui l'export répond 501. Ces quatre réglages ont un
# défaut qui convient à un VPS d'un gigaoctet : n'y toucher que sur une autre
# machine.
#   TYPST_BIN         — chemin du binaire (défaut : `typst` dans le PATH) ;
#   TYPST_MEMORY_MB   — plafond mémoire dur d'un rendu, en Mo (défaut : 400) ;
#   TYPST_TIMEOUT_MS  — durée maximale d'un rendu, en millisecondes (défaut : 30000) ;
#   TYPST_FONT_PATH   — dossier de polices : s'il est donné, Typst n'utilise que
#                       celles-là et ignore les polices du système.
# TYPST_BIN=typst
# TYPST_MEMORY_MB=400
# TYPST_TIMEOUT_MS=30000
# TYPST_FONT_PATH=

# --- Essais seulement : à ne jamais poser en production ---
# Adresse d'un faux service, pour jouer l'application sans clé ni courriel réels
# (tools/instance-test.js, tools/faux-anthropic.js, tools/faux-mailgun.js).
# ANTHROPIC_API_URL=http://127.0.0.1:19001
# MAILGUN_API_URL=http://127.0.0.1:19002
# MISTRAL_API_URL=   (même principe ; aucun faux Mistral n'est livré)
# SCALEWAY_API_URL=  (même principe ; aucun faux Scaleway n'est livré)
