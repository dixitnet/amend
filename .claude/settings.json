{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run test:server:*)",
      "Bash(npm run test:client:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:check:*)",
      "Bash(npm run build:client:*)",
      "Bash(npx prettier:*)",
      "Bash(npx eslint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git commit:*)",
      "Bash(git push origin dev-claude:*)",
      "Bash(git push -u origin dev-claude:*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git reset:*)",
      "Bash(git stash:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(./deploy/livrer.sh:*)",
      "Bash(./deploy/deployer.sh:*)",
      "Bash(./deploy/deploy.sh:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
